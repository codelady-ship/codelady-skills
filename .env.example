# Copy to .env.local for local work (git ignores it). On Cloudflare, put secrets in with
#   npx wrangler secret put NAME
# and plain settings under "vars" in wrangler.jsonc. Never commit real values.
# Full setup steps: docs/MARKETPLACE.md

# ---------------------------------------------------------------- site
# Public address of the site, no trailing slash (used for sign-in and checkout return links).
SITE_URL=
# Comma-separated emails that get the admin page (/[lang]/admin). Checked on the server only.
ADMIN_EMAILS=

# ---------------------------------------------------------------- test mode
# Mock mode = fake sign-in (test accounts), in-memory database, test payments.
# On whenever Supabase is NOT configured, unless MOCK_AUTH=0. wrangler.jsonc sets 0 for production.
MOCK_AUTH=
# Optional: fixed secret for mock session cookies (default: random per server start).
MOCK_SESSION_SECRET=

# ---------------------------------------------------------------- Supabase (login + database)
# Project Settings → API. The anon key is public by design; the service-role key is SECRET
# (server only, bypasses Row Level Security). Shared with the voice app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- payments (Lemon Squeezy)
# lemonsqueezy | mock | none. Default: lemonsqueezy when its keys are set, mock in mock mode.
MARKET_PAYMENT_PROVIDER=
# Settings → API → new API key (SECRET).
LEMONSQUEEZY_API_KEY=
# Settings → Stores → the store's number.
LEMONSQUEEZY_STORE_ID=
# Variant id of the one-time product "Skill (one-time)" (price is overridden per skill).
LEMONSQUEEZY_VARIANT_ONE_TIME=
# Variant id of the monthly subscription product "Skill (monthly)".
LEMONSQUEEZY_VARIANT_MONTHLY=
# Settings → Webhooks → the signing secret you typed for /api/market/webhook (SECRET).
LEMONSQUEEZY_WEBHOOK_SECRET=
# 1 (default) = Lemon Squeezy test mode; set 0 only when going live.
LEMONSQUEEZY_TEST_MODE=
# Platform share of each sale in percent (default 20).
MARKET_FEE_PERCENT=

# ---- AI engine (skills, translation, smart search) ----
# Free key: https://aistudio.google.com/apikey  (put the real key only in .env.local, never in git)
GEMINI_API_KEY=
# Models tried in order (checked 2026-11-11). Pro models have no free quota, so they are left out.
GEMINI_TEXT_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-lite-latest
# Order of services. When one is out of its free limit, busy or slow, the next one answers.
AI_PROVIDERS=gemini,groq,openrouter,workers-ai
# Free key: https://console.groq.com/keys  (Qwen 3.8 by Alibaba, GPT-OSS)
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# Free key: https://openrouter.ai/keys  (":free" models: ERNIE by Baidu, dots by Xiaohongshu). Free models may log prompts.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,dots-studio/dots-3-note-preview:free,openrouter/free
